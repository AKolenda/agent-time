# Network address on the desktop that runs Agent Time.
AGENT_TIME_HOST=127.0.0.1
AGENT_TIME_PORT=8080

# Comma-separated IPs allowed to read Agent Time's API.
AGENT_TIME_TRUSTED_CLIENTS=127.0.0.1

# Client-facing chat descriptions via the local Codex / Claude Code CLIs (1 = on).
AGENT_TIME_SUMMARIES=1
AGENT_TIME_SUMMARY_MODEL=gpt-5.6-luna
AGENT_TIME_SUMMARY_EFFORT=low
