[Unit]
Description=Agent Time local API and dashboard
After=default.target

[Service]
Type=simple
Environment=AGENT_TIME_HOST=127.0.0.1
Environment=AGENT_TIME_PORT=8765
EnvironmentFile=-%h/.config/agent-time.env
ExecStart=/usr/bin/env python3 %h/Desktop/agent-time/fable-time.py --no-browser
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
